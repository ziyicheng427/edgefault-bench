{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgefault-bench.org/schemas/prepared-feature-table-v2.schema.json",
  "title": "EdgeFault-Bench prepared feature table v2",
  "type": "object",
  "required": ["schema_version", "dataset_id", "feature_names", "samples"],
  "properties": {
    "schema_version": {"const": 2},
    "dataset_id": {"type": "string", "minLength": 1},
    "feature_names": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "preparation": {"type": "object"},
    "samples": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/sample"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "domainValue": {"type": ["string", "number", "boolean"]},
    "sample": {
      "type": "object",
      "required": [
        "recording_id", "label", "domains", "features",
        "window_id", "start_sample", "end_sample"
      ],
      "additionalProperties": false,
      "properties": {
        "recording_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "domains": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/domainValue"}
        },
        "features": {
          "type": "array", "minItems": 1,
          "items": {"type": "number"}
        },
        "window_id": {"type": "string", "minLength": 1},
        "start_sample": {"type": "integer", "minimum": 0},
        "end_sample": {"type": "integer", "exclusiveMinimum": 0}
      }
    }
  }
}
