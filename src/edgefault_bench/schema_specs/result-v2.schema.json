{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgefault-bench.org/schemas/result-v2.schema.json",
  "title": "EdgeFault-Bench core result v2",
  "type": "object",
  "required": [
    "schema_version", "benchmark_id", "model_id", "task_id", "created_at",
    "git_commit", "protocol", "model_plugin", "environment", "partition_sizes",
    "input_artifacts", "runs"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "benchmark_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$|^unknown$"},
    "protocol": {"type": "object", "minProperties": 1},
    "model_plugin": {"type": "object", "minProperties": 1},
    "environment": {"type": "object", "minProperties": 1},
    "partition_sizes": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 1},
        "validation": {"type": "integer", "minimum": 1},
        "test": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "input_artifacts": {
      "type": "object",
      "required": ["task_manifest", "prepared_feature_table", "dataset_manifest", "training_policy"],
      "additionalProperties": false,
      "properties": {
        "task_manifest": {"$ref": "#/$defs/artifactRef"},
        "prepared_feature_table": {
          "anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]
        },
        "dataset_manifest": {
          "anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]
        },
        "training_policy": {
          "anyOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]
        }
      }
    },
    "framework_overhead": {"type": "object", "minProperties": 1},
    "runs": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/run"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "macro_f1", "balanced_accuracy", "worst_condition_macro_f1",
        "per_condition_macro_f1"
      ],
      "properties": {
        "macro_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "balanced_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "worst_condition_macro_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "per_condition_macro_f1": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "additionalProperties": true
    },
    "complexity": {
      "type": "object",
      "required": ["trainable_parameters", "serialized_size_bytes"],
      "properties": {
        "trainable_parameters": {"type": "integer", "minimum": 0},
        "serialized_size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "latency": {
      "type": "object",
      "required": ["batch_size", "warmup", "repeats", "median_ms", "p95_ms"],
      "properties": {
        "batch_size": {"type": "integer", "minimum": 1},
        "warmup": {"type": "integer", "minimum": 0},
        "repeats": {"type": "integer", "minimum": 1},
        "median_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "run": {
      "type": "object",
      "required": ["seed", "status"],
      "properties": {
        "seed": {"type": "integer"},
        "status": {"enum": ["ok", "failed"]},
        "error": {"type": "string", "minLength": 1},
        "fit_seconds": {"type": "number", "minimum": 0},
        "validation": {"$ref": "#/$defs/metrics"},
        "test": {"$ref": "#/$defs/metrics"},
        "complexity": {"$ref": "#/$defs/complexity"},
        "latency": {"$ref": "#/$defs/latency"},
        "test_predictions": {
          "type": "object",
          "required": ["truth", "predictions", "groups", "recording_ids"],
          "additionalProperties": false,
          "properties": {
            "truth": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "predictions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "groups": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "recording_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ok"}}},
          "then": {
            "required": ["fit_seconds", "validation", "test", "complexity", "latency"]
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"required": ["error"]}
        }
      ]
    }
  }
}
